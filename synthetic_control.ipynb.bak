  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c39ec4bf",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "combined_data = local_config['combined_data_path']\n",
    "raw_df = pd.read_csv(combined_data)"
