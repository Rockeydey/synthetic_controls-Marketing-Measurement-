    "train_prophet = results['train_data']\n",
    "test_prophet = results['test_data']\n",
    "\n",
    "\n",
    "plot_forecast_comparison(\n",
    "    model,\n",
    "    train_data=train_prophet,\n",
    "    test_data=test_prophet,\n",
    "    kpi=kpi,\n",
    "    figsize=(12, 5),\n",
    "    colors=None,\n",
    "    save_path=chart_save,\n",
    "    show_plot=True\n",
    ")"
